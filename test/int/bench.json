{
  "deployment": "PiSensor",
  "dictionary": "inputs/PiSensorTopologyDictionary.json",
  "serial": "81493bc1e640bea9",
  "notes": "PiSensor system bench: Raspberry Pi 5 `soakee` (ssh host `pi`) <-RFM69-> Feather M0 ground radio on the workstation /dev/ttyACM0 -> ground/feather_bridge.py -> fprime-yamcs (HTTP 8190, instance fprime-project). Run fth from the campaign root on the workstation: `uut` is the checkout of this repository, `yamcs-config` the YAMCS configuration directory of ground/README.md, `inputs` holds the image and its dictionary; python3 (yamcs-client, pyserial, requests) and fprime-yamcs are on PATH. The unit has no debugger: flash copies the image over ssh and starts it, and the serial is the Pi serial number of /proc/cpuinfo. Image, ground system and sender are those of test/int/bench/yamcs_bench.py; the recorder is test/int/bench/yamcs_recorder.py (ground reception time, CFDP transfers, frames, received files); the actions are test/int/bench/uut.py.",
  "flash": "{python} {adapter} flash --prm inputs/PrmDb.dat {image}",
  "dump": "{python} {adapter} dump {readback}",
  "gds": "{python} {adapter} gds --dictionary {dictionary} --logs {logs} --bridge {bridge} --uart {uart} --yamcs-config {yamcs_config}",
  "recorder": "{python} {bench}/yamcs_recorder.py --url {yamcs_url} --instance {yamcs_instance} --root {yamcs_root} --deployment PiSensor --dictionary {dictionary} --logs {logs} --gen-offset {gen_offset}",
  "send": "{python} {adapter} send --dictionary {dictionary} --logs {logs} {command} {args}",
  "actions": {
    "platform": "{python} {bench}/uut.py action platform --ssh {uut_ssh} --remote-dir {uut_dir} --logs {logs}",
    "sockets": "{python} {bench}/uut.py action sockets --ssh {uut_ssh} --remote-dir {uut_dir} --logs {logs}",
    "clock": "{python} {bench}/uut.py action clock --ssh {uut_ssh} --remote-dir {uut_dir} --logs {logs}",
    "clean_products": "{python} {bench}/uut.py action clean_products --ssh {uut_ssh} --remote-dir {uut_dir} --logs {logs}",
    "final_state": "{python} {bench}/uut.py action final_state --ssh {uut_ssh} --remote-dir {uut_dir} --logs {logs}",
    "wait_cfdp": "{python} {bench}/uut.py action wait_cfdp --ssh {uut_ssh} --remote-dir {uut_dir} --logs {logs} --timeout 1200",
    "bench_release": "{python} {adapter} stop"
  },
  "vars": {
    "python": "python3",
    "bench": "uut/test/int/bench",
    "adapter": "uut/test/int/bench/yamcs_bench.py --pi-dir pisensor-campaign/sys-run",
    "bridge": "uut/ground/feather_bridge.py",
    "yamcs_config": "yamcs-config",
    "uart": "/dev/ttyACM0",
    "uut_ssh": "pi",
    "uut_dir": "pisensor-campaign/sys-run",
    "yamcs_url": "localhost:8190",
    "yamcs_instance": "fprime-project",
    "yamcs_root": "/PiSensor_PiSensor",
    "gen_offset": "1.0"
  },
  "provenance": {
    "serial_re": "Serial# = (\\S+)"
  },
  "timeouts": {
    "flash_s": 300,
    "gds_start_s": 60,
    "recorder_start_s": 20,
    "send_s": 60,
    "command_s": 30,
    "wait_cfdp_s": 960,
    "platform_s": 60,
    "sockets_s": 60,
    "clock_s": 60,
    "clean_products_s": 60,
    "final_state_s": 60,
    "bench_release_s": 60
  }
}
